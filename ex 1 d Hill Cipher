import java.util.Scanner;

class Hill {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[][] key = {{3, 3}, {2, 5}}; 
        System.out.print("Enter 2-letter message: ");
        String msg = sc.next().toUpperCase();
        int p0 = msg.charAt(0) - 'A';
        int p1 = msg.charAt(1) - 'A';
        int c0 = (key[0][0] * p0 + key[0][1] * p1) % 26;
        int c1 = (key[1][0] * p0 + key[1][1] * p1) % 26;
        char clean0 = (char) (c0 + 'A');
        char clean1 = (char) (c1 + 'A');
        System.out.println("Encrypted text: " + clean0 + clean1);
    }
    }
